{
  "name": "@saydo/cli",
  "version": "0.1.0-rc.2",
  "license": "Apache-2.0",
  "description": "SayDo 可分发 Node 运行时与命令行 supervisor",
  "type": "module",
  "bin": {
    "saydo": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node ../../scripts/third-party-notices.mjs --check && node scripts/build.mjs",
    "prepack": "pnpm build",
    "verify:distribution": "pnpm build && node scripts/verify-distribution.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "koffi": "3.1.6"
  },
  "devDependencies": {
    "@saydo/contracts": "workspace:*",
    "@saydo/platform": "workspace:*",
    "@types/node": "^22.17.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
