{
  "schema_version": 1,
  "comment": "PG-01B remote surface exact-set. recovery is a composition root, not IdentityVia. Each entry has exact HTTP method or protocol NOT_APPLICABLE, via, and per-via outcome. Remote via (tailnet/mobile_lan) HTTP business /api/** and WS business connections are fail-closed; health/readiness/static_shell remain reachable.",
  "grammar": {
    "http_method_eq": "req.method === \"METHOD\" block or same-statement",
    "http_method_ne_post_remainder": "after if (req.method !== \"POST\") 405, remainder is POST",
    "http_get_projection": "function routeConsoleApi; p === PATH / regex.exec(p)",
    "http_literal": "(pathname|u.pathname|p) === \"PATH\"",
    "http_regex": "/^PATH$/",
    "http_prefix": "pathname.startsWith(\"PATH\")",
    "http_s3_face": "pathname.startsWith(\"/api/s3/\") and approve-merge regex → POST",
    "skip_guard_prefixes": "/api/ /ws/ /dev/ /api/setup/",
    "static_shell": "serveConsoleStatic( → GET /*",
    "safe_redirect": "writeHead(308 → GET 308:localhost",
    "health_readiness": "unscoped /health /readyz → GET",
    "ws_method": "NOT_APPLICABLE",
    "ws_switch": "switch (msg.t) case \"MSG\"",
    "ws_quoted": "dotted message tokens",
    "ws_path": "path: \"/ws/voice\"",
    "unix_listen": "server.listen(sockPath)",
    "unix_post_gate": "req.method !== \"POST\" || url !== /gate",
    "unix_win32_loopback": "process.platform === \"win32\" + listenGateHttp",
    "guard_http": "remoteHttpBusinessDecision",
    "guard_ws": "remoteVoiceWsDecision"
  },
  "source_roots": {
    "main": "packages/daemon/src/index.ts",
    "recovery": "packages/daemon/src/api/recoveryOnlyServer.ts",
    "voice": "packages/daemon/src/voice/hub.ts",
    "tier1": "packages/daemon/src/tier1/gateServer.ts"
  },
