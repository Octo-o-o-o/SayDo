  ],
  "provenance_binding": {
    "repo": "SayDo",
    "commit": "d023ffcebfad38563bc988977192e77654d7e2a1",
    "workflow": ".github/workflows/release.yml",
    "signer_identity": "release workflow identity(签名主体待 RF-10 定档,样例不伪造)",
