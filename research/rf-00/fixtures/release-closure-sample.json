  "negative_cases": [
    { "id": "sbom-missing-component", "mutation": "删除一个 npm_dependency component", "expect": "校验拒绝:闭包条目缺失" },
    { "id": "provenance-commit-shape", "mutation": "commit 改非 40-hex", "expect": "校验拒绝:commit 形状非法" },
    { "id": "exact-set-shadow-asset", "mutation": "资产清单多出一个未登记文件名", "expect": "校验拒绝:exact-set 阴影资产" },
    { "id": "closure-infer-from-lockfile", "mutation": "声称根 lockfile 单独证明安装闭包", "expect": "校验拒绝:闭包需逐条登记,不推导" }
  ]
