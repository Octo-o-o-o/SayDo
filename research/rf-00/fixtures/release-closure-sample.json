      "SHA256SUMS": "sha256:EXAMPLEeeee",
      "release-metadata.json": "sha256:EXAMPLEffff",
      "saydo-cli-0.0.0-sample.tgz": "sha256:EXAMPLE0000"
    },
    "binding_rule": "发布验证把实际下载/安装字节 digest 绑定到 {repo, commit, workflow, signer};不是只验文件存在或 tarball 自洽"
